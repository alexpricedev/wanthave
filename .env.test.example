# Copy to .env.test and adjust DATABASE_URL. Bun loads this file automatically
# when NODE_ENV=test, which is what `bun run test` sets.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wanthave-test
CRYPTO_PEPPER=test-pepper-do-not-use-in-production
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=WantHave
EMAIL_PROVIDER=console
FROM_EMAIL=noreply@example.com
FROM_NAME=WantHave
SESSION_COOKIE_NAME=wanthave_session
